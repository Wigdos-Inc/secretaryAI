rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Plans: anyone can read plans, only admins can create/update/delete
    match /Plans/{planId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Users: each authenticated user may create and manage their own profile document.
    // Admins are checked via custom claims (`request.auth.token.admin == true`).
    match /Users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update, delete: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);

      // Chats subcollection belongs to the user and follows same rules
      match /chats/{chatId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      }
    }

    // Keep any other collections closed by default (deny)
  }

  // Helper to check admin flag on the requesting user's profile document
  function isAdmin() {
    return request.auth != null
      && get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.admin == true;
  }
}