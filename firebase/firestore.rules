rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Plans: anyone can read plans; only authenticated users may create/update/delete
    match /Plans/{planId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Users: each authenticated user may create and manage their own profile document.
    match /Users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;

      // Chats subcollection belongs to the user and follows same owner-only rules
      match /chats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Keep any other collections closed by default (deny)
  }

  // No admin helper — rules are owner-only in this project configuration.
}